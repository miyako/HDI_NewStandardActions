{
	"destination": "detailScreen",
	"windowSizingX": "fixed",
	"windowMinHeight": 700,
	"width": 1080,
	"height": 700,
	"markerHeader": 15,
	"markerBody": 200,
	"markerBreak": 220,
	"markerFooter": 240,
	"events": [
		"onLoad",
		"onUnload",
		"onTimer",
		"onPageChange"
	],
	"method": "method.4dm",
	"pageFormat": {
		"paperName": "US Letter",
		"paperWidth": "612pt",
		"paperHeight": "792pt"
	},
	"pages": [
		{
			"objects": {
				"Tab Control": {
					"type": "tab",
					"top": 20,
					"left": 20,
					"width": 1040,
					"height": 660,
					"sizingX": "grow",
					"sizingY": "grow",
					"dataSource": "Tab Control",
					"dataSourceTypeHint": "arrayText",
					"labels": [
						"Information",
						"Demo",
						"Get action info"
					],
					"action": "GotoPage",
					"events": [
						"onClick"
					]
				},
				"stText": {
					"type": "input",
					"top": 80,
					"left": 40,
					"width": 280,
					"height": 580,
					"sizingY": "grow",
					"dataSource": "stText",
					"spellcheck": true,
					"styledText": true,
					"allowFontColorPicker": true,
					"contextMenu": "none",
					"dragging": "none",
					"dropping": "custom",
					"method": "ObjectMethods/stText.4dm",
					"events": [
						"onClick",
						"onSelectionChange"
					]
				}
			}
		},
		{
			"objects": {
				"Round Rectangle4": {
					"type": "rectangle",
					"top": 320,
					"left": 480,
					"width": 520,
					"height": 300,
					"fill": "#D9D9D9",
					"stroke": "#C0C0C0",
					"borderRadius": 5
				},
				"Text4": {
					"type": "text",
					"top": 71,
					"left": 40,
					"width": 940,
					"height": 50,
					"class": "HDI",
					"textAlign": "center",
					"text": "How do I use standard actions with text and styled text ?"
				},
				"Text5": {
					"type": "text",
					"top": 260,
					"left": 40,
					"width": 420,
					"height": 269,
					"class": "default",
					"text": "The standard actions can be defined:\r\r— In the buttons, via the property list (fig. 1)\r\r— In the menus, via the menu editor (fig. 2)\r\r— In the buttons by programming:\r\r          OBJECT SET ACTION(*;\"fontBold\";ak font bold)\r\r— In the menus by programming:\r\r          SET MENU ITEM PROPERTY(menu_Edit;-1;Associated standard action;ak cut)\r"
				},
				"Picture7": {
					"type": "picture",
					"top": 474,
					"left": 515,
					"width": 451,
					"height": 124,
					"pictureFormat": "scaled",
					"picture": "Images/Picture7.png"
				},
				"Text6": {
					"type": "text",
					"top": 115,
					"left": 40,
					"width": 960,
					"height": 129,
					"class": "default",
					"text": "Thanks to standard actions, a lot of actions can be performed without any programming.\r(Cancel, Accept, Next Record, Previous Page, etc.)\r\rThe number of these actions has been increased and can now apply to text areas (Simple text, Styled text and of course 4D Write Pro).\r\rThe activation/deactivation of the buttons and menus are automatic according to the current text selection, and apply to the current object (the one with the focus)."
				},
				"Picture8": {
					"type": "picture",
					"top": 360,
					"left": 523,
					"width": 434,
					"height": 81,
					"pictureFormat": "scaled",
					"picture": "Images/Picture8.png"
				},
				"Text7": {
					"type": "text",
					"top": 444,
					"left": 725,
					"width": 51,
					"height": 14,
					"textAlign": "center",
					"fontTheme": "additional",
					"text": "Fig. 1"
				},
				"Text8": {
					"type": "text",
					"top": 534,
					"left": 725,
					"width": 51,
					"height": 14,
					"textAlign": "center",
					"fontTheme": "additional",
					"text": "Fig. 2"
				}
			}
		},
